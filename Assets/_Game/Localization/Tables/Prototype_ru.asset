  - m_Id: 264371628281900
    m_Localized: "E \u2014 \u043F\u0435\u0440\u0435\u0447\u0438\u0442\u0430\u0442\u044C
      \u0437\u0430\u0434\u0430\u043D\u0438\u0435 \u0432 \u0441\u0443\u043C\u043A\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 264371628281901
    m_Localized: "E \u2014 \u0432\u044B\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 264371628281902
    m_Localized: "\u041F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C \u0443\u0435\u0445\u0430\u0442\u044C,
      \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u0435 \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u043D\u044B\u0439
      \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 264371628281903
    m_Localized: "\u041F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C \u0443\u0435\u0445\u0430\u0442\u044C,
      \u0434\u043E\u0447\u0438\u0442\u0430\u0439\u0442\u0435 \u0437\u0430\u0434\u0430\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 264371628281904
    m_Localized: "\u041F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C \u0443\u0435\u0445\u0430\u0442\u044C,
      \u0441\u043E\u0431\u0435\u0440\u0438\u0442\u0435 \u0434\u043E\u0440\u043E\u0436\u043D\u0443\u044E
      \u0441\u0443\u043C\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 264371628281905
    m_Localized: "\u041F\u0430\u043F\u043A\u0430 \u0438 \u043F\u0440\u0438\u0451\u043C\u043D\u0438\u043A
      \u0443\u043B\u043E\u0436\u0435\u043D\u044B. \u041F\u0435\u0440\u0435\u0434
      \u0432\u044B\u0445\u043E\u0434\u043E\u043C \u0437\u0430\u0434\u0430\u043D\u0438\u0435
      \u043C\u043E\u0436\u043D\u043E \u043F\u0435\u0440\u0435\u0447\u0438\u0442\u0430\u0442\u044C
      \u0443 \u0441\u0443\u043C\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 264371628281906
    m_Localized: "\u041F\u043E\u0437\u0436\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 264371628281907
    m_Localized: "\u0417\u0430\u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0438\u0440\u043E\u0432\u0430\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 264371628281908
    m_Localized: "[\u0412\u044B \u043D\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442\u0435
      \u0438 \u0432\u043A\u043B\u044E\u0447\u0430\u0435\u0442\u0435 \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u043D\u043E\u0435
      \u0440\u0430\u0434\u0438\u043E.]"
    m_Metadata:
      m_Items: []
  - m_Id: 264371628281909
    m_Localized: "\u041F\u0415\u0420\u0415\u0425\u041E\u0414 \u041F\u0420\u041E\u0422\u041E\u0422\u0418\u041F\u0410:
      \u0441\u0442\u043E\u0439\u043A\u0430 \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u0438
      \u0438 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0435 \u0447\u0438\u0442\u0430\u0442\u044C
      \u0433\u043E\u0441\u0442\u0435\u0432\u0443\u044E \u043A\u043D\u0438\u0433\u0443
      \u043F\u043E\u043A\u0430 \u043D\u0435 \u0440\u0435\u0430\u043B\u0438\u0437\u043E\u0432\u0430\u043D\u044B.
      \u0420\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u044F \u043D\u0435
      \u0441\u043E\u0441\u0442\u043E\u044F\u043B\u0430\u0441\u044C. \u041F\u0440\u043E\u0431\u0435\u043B/Enter
      \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0439
      \u0442\u0435\u0441\u0442 \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0430;
      \u044D\u0442\u043E \u043D\u0435 \u0434\u0430\u0451\u0442 \u0441\u044E\u0436\u0435\u0442\u043D\u043E\u0433\u043E
      \u0434\u043E\u0441\u0442\u0443\u043F\u0430 \u043A \u043B\u0438\u0447\u043D\u044B\u043C
      \u0437\u0430\u043F\u0438\u0441\u044F\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 612165945790464
    m_Localized: "\u0420\u0430\u0431\u043E\u0447\u0438\u0439 \u044D\u0444\u0438\u0440:
      \u0442\u0435\u043A\u0441\u0442 \u0438 \u0448\u0443\u043C \u043F\u0440\u0438\u0451\u043C\u043D\u0438\u043A\u0430.
      \u041C\u0443\u0437\u044B\u043A\u0430\u043B\u044C\u043D\u0430\u044F \u043F\u0430\u0443\u0437\u0430
      \u043F\u043E\u043A\u0430 \u043D\u0435 \u0441\u043E\u0437\u0434\u0430\u043D\u0430."
