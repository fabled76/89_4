  - m_Id: 440964178907149
    m_Localized: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0432 \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 440964178907150
    m_Localized: "\u0416\u0423\u0420\u041D\u0410\u041B\u0418\u0421\u0422: \xAB\u0412\u044B
      \u0437\u0434\u0435\u0441\u044C \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442\u0435?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 440964178907151
    m_Localized: "\u041C\u0423\u0416\u0427\u0418\u041D\u0410: \xAB\u041F\u043E \u043D\u043E\u0447\u0430\u043C\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 440964178907152
    m_Localized: "\u0416\u0423\u0420\u041D\u0410\u041B\u0418\u0421\u0422: \xAB\u042F
      \u043F\u0440\u0438\u0435\u0445\u0430\u043B \u0438\u0437-\u0437\u0430 \u043F\u0440\u043E\u043F\u0430\u0432\u0448\u0435\u0433\u043E
      \u0432\u0435\u0434\u0443\u0449\u0435\u0433\u043E \u043C\u0435\u0441\u0442\u043D\u043E\u0439
      \u0441\u0442\u0430\u043D\u0446\u0438\u0438\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 440964178907153
    m_Localized: "\u041C\u0423\u0416\u0427\u0418\u041D\u0410: \xAB\u0421\u0435\u0439\u0447\u0430\u0441
      \u0438\u0434\u0451\u0442 \u0435\u0433\u043E \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0430\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 440964178907154
    m_Localized: "\u0412\u0430\u0448 \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u043D\u043E\u0439
      \u043F\u0440\u0438\u0451\u043C\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 440964178907155
    m_Localized: "\u041F\u0440\u0438\u0451\u043C\u043D\u0438\u043A \u0432\u044B\u043A\u043B\u044E\u0447\u0435\u043D
      \u0438 \u043B\u0435\u0436\u0438\u0442 \u0440\u044F\u0434\u043E\u043C \u0441
      \u0432\u0435\u0449\u0430\u043C\u0438. E \u0443 \u043F\u0440\u0438\u0451\u043C\u043D\u0438\u043A\u0430
      \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u0432\u0437\u044F\u0442\u044C
      \u0435\u0433\u043E; \u043E\u0441\u043C\u043E\u0442\u0440 \u0441\u0443\u043C\u043A\u0438
      \u044D\u0442\u043E\u0433\u043E \u043D\u0435 \u0434\u0435\u043B\u0430\u0435\u0442.
      \u041C\u043E\u0436\u043D\u043E \u0432\u044B\u0439\u0442\u0438 \u0432 \u043A\u043E\u0440\u0438\u0434\u043E\u0440
      \u0431\u0435\u0437 \u0440\u0430\u0434\u0438\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 440964183101440
    m_Localized: "[\u0412\u044B \u0431\u0435\u0440\u0451\u0442\u0435 \u043F\u0440\u0438\u0451\u043C\u043D\u0438\u043A.
      \u041E\u043D \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F \u0432\u044B\u043A\u043B\u044E\u0447\u0435\u043D\u043D\u044B\u043C.]\n\u041A\u043E\u0433\u0434\u0430
      \u0440\u0430\u0434\u0438\u043E \u043F\u0440\u0438 \u0432\u0430\u0441, \u043B\u0435\u0432\u0430\u044F
      Shift \u0432\u043A\u043B\u044E\u0447\u0430\u0435\u0442 \u043F\u0438\u0442\u0430\u043D\u0438\u0435.
      E \u0443 \u0441\u0443\u043C\u043A\u0438 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u0442\u0435\u043A\u0441\u0442 \u044D\u0444\u0438\u0440\u0430 \u0432\u043A\u043B\u044E\u0447\u0451\u043D\u043D\u043E\u0433\u043E
      \u043F\u0440\u0438\u0451\u043C\u043D\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 440964183101441
    m_Localized: "\u0416\u0423\u0420\u041D\u0410\u041B\u0418\u0421\u0422: \xAB\u041F\u043E\u0441\u043B\u0443\u0448\u0430\u0435\u043C,
      \u043E \u043A\u0430\u043A\u043E\u0439 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0435
      \u043E\u043D \u0433\u043E\u0432\u043E\u0440\u0438\u0442\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 440964183101442
    m_Localized: "\u041B\u0435\u0432\u0430\u044F Shift \u0432\u043A\u043B\u044E\u0447\u0430\u0435\u0442
      \u0432\u0437\u044F\u0442\u044B\u0439 \u043F\u0440\u0438\u0451\u043C\u043D\u0438\u043A.
      \u0417\u0430\u0442\u0435\u043C E \u0443 \u0441\u0443\u043C\u043A\u0438 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u0442\u0435\u043A\u0441\u0442 \u044D\u0444\u0438\u0440\u0430. \u0411\u0438\u0440\u044E\u0437\u043E\u0432\u044B\u0439
      \u0442\u0435\u0441\u0442\u043E\u0432\u044B\u0439 \u0441\u0442\u0435\u043D\u0434
      \u0437\u0430\u043C\u0435\u043D\u044F\u0435\u0442 \u043F\u0443\u0441\u0442\u0443\u044E
      \u0431\u0430\u0442\u0430\u0440\u0435\u044E, \u043D\u0435 \u0432\u043A\u043B\u044E\u0447\u0430\u044F
      \u0440\u0430\u0434\u0438\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 440964183101443
    m_Localized: "\u0414\u0418\u041A\u0422\u041E\u0420: \xAB\u0414\u043E\u0431\u0440\u044B\u0439
      \u0432\u0435\u0447\u0435\u0440. \u041D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u043C:
      \u043E\u0431\u044A\u044F\u0432\u043B\u0435\u043D\u0438\u044F \u043D\u0430 \u0437\u0430\u0432\u0442\u0440\u0430
      \u043D\u0443\u0436\u043D\u043E \u043F\u0435\u0440\u0435\u0434\u0430\u0442\u044C
      \u043D\u0430 \u0441\u0442\u0430\u043D\u0446\u0438\u044E \u0434\u043E \u043F\u043E\u043B\u0443\u0434\u043D\u044F.
      \u041C\u044B \u0432\u0435\u0440\u043D\u0451\u043C\u0441\u044F \u043F\u043E\u0441\u043B\u0435
      \u043C\u0443\u0437\u044B\u043A\u0438\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 440964183101444
    m_Localized: "\u0416\u0423\u0420\u041D\u0410\u041B\u0418\u0421\u0422: \xAB\u0421\u043F\u0440\u043E\u0448\u0443,
      \u0447\u0442\u043E \u043E\u043D \u0438\u043C\u0435\u043B \u0432 \u0432\u0438\u0434\u0443\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 440964183101445
    m_Localized: "\u041A\u043E\u0440\u0438\u0434\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 440964183101446
    m_Localized: "\u0416\u0423\u0420\u041D\u0410\u041B\u0418\u0421\u0422: \xAB\u0423\u0448\u0451\u043B\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 440964183101447
    m_Localized: "\u0416\u0423\u0420\u041D\u0410\u041B\u0418\u0421\u0422: \xAB\u0423\u0442\u0440\u043E\u043C
      \u0441\u043F\u0440\u043E\u0448\u0443 \u0443 \u0441\u0442\u043E\u0439\u043A\u0438\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 440964183101448
    m_Localized: "\u041F\u0420\u041E\u0422\u041E\u0422\u0418\u041F: \u043F\u0440\u043E\u0431\u043D\u044B\u0439
      \u044D\u043F\u0438\u0437\u043E\u0434 \u043F\u0435\u0440\u0432\u043E\u0439 \u043D\u043E\u0447\u0438
      \u0437\u0430\u0432\u0435\u0440\u0448\u0451\u043D. \u0423\u0442\u0440\u0435\u043D\u043D\u044F\u044F
      \u0431\u0435\u0441\u0435\u0434\u0430 \u0435\u0449\u0451 \u043D\u0435 \u0432\u043A\u043B\u044E\u0447\u0435\u043D\u0430.\n\u042D\u0442\u043E
      \u0441\u043B\u0443\u0436\u0435\u0431\u043D\u043E\u0435 \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435,
      \u043D\u0435 \u0440\u0435\u043F\u043B\u0438\u043A\u0430 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0430.
      Esc \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0435\u0433\u043E,
      D \u0437\u0430\u0432\u0435\u0440\u0448\u0430\u0435\u0442 \u0447\u0442\u0435\u043D\u0438\u0435.
      \u041C\u043E\u0436\u043D\u043E \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C\u0441\u044F
      \u0438 \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u0432 \u043D\u043E\u043C\u0435\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 440964183101449
    m_Localized: "\u0422\u0435\u043A\u0443\u0449\u0430\u044F \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 440964183101450
    m_Localized: "\u0417\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0435 \u0442\u0435\u043A\u0443\u0449\u0443\u044E
