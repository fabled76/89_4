  m_TableData:
  - m_Id: 884871168
    m_Localized: "\u0413\u043E\u0441\u0442\u0435\u0432\u0430\u044F \u043A\u043D\u0438\u0433\u0430
      \u043C\u043E\u0442\u0435\u043B\u044F \u2014 \u0447\u0435\u0440\u043D\u043E\u0432\u043E\u0439
      \u0442\u0435\u043A\u0441\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 947785728
    m_Localized: "\u0413\u043E\u0441\u0442\u0435\u0432\u0430\u044F \u043A\u043D\u0438\u0433\u0430
      \u0440\u0430\u0441\u043A\u0440\u044B\u0442\u0430 \u0440\u044F\u0434\u043E\u043C
      \u0441 \u043F\u0443\u0441\u0442\u044B\u043C \u043A\u0440\u044E\u0447\u043A\u043E\u043C
      \u0434\u043B\u044F \u043A\u043B\u044E\u0447\u0430. \u041F\u043E\u0447\u0442\u0438
      \u0443 \u043A\u0430\u0436\u0434\u043E\u0439 \u0437\u0430\u043F\u0438\u0441\u0438
      \u0435\u0441\u0442\u044C \u0434\u0430\u0442\u0430 \u043F\u0440\u0438\u0431\u044B\u0442\u0438\u044F,
      \u043D\u043E\u043C\u0435\u0440 \u043A\u043E\u043C\u043D\u0430\u0442\u044B \u0438
      \u0434\u0430\u0442\u0430 \u043E\u0442\u044A\u0435\u0437\u0434\u0430. \u0423
      \u043E\u0434\u043D\u043E\u0439 \u0437\u0430\u043F\u0438\u0441\u0438 \u0434\u0430\u0442\u044B
      \u043E\u0442\u044A\u0435\u0437\u0434\u0430 \u043D\u0435\u0442.\n\n\u041A\u043E\u043C\u043D\u0430\u0442\u0430
      12: \u0438\u043C\u044F \u0433\u043E\u0441\u0442\u044F \u0441\u0442\u0451\u0440\u0442\u043E.
      \u041D\u0430 \u043F\u043E\u043B\u044F\u0445 \u043D\u0430\u0440\u0438\u0441\u043E\u0432\u0430\u043D\u0430
      \u0443\u0437\u043A\u0430\u044F \u0444\u0438\u0433\u0443\u0440\u0430 \u0432
      \u0434\u043B\u0438\u043D\u043D\u043E\u043C \u043F\u0430\u043B\u044C\u0442\u043E.
      \u041E\u0447\u0435\u0440\u0442\u0430\u043D\u0438\u044F \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u044E\u0442
      \u0441\u0438\u043B\u0443\u044D\u0442 \u0432 \u0434\u0430\u043B\u044C\u043D\u0435\u043C
      \u043A\u043E\u043D\u0446\u0435 \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 951980032
    m_Localized: "\u0414\u0440\u0443\u0433\u0438\u043C \u043F\u043E\u0447\u0435\u0440\u043A\u043E\u043C
      \u043F\u0440\u0438\u043F\u0438\u0441\u0430\u043D\u043E: \xAB\u041F\u0440\u043E\u0441\u0438\u043B
      \u0432\u0441\u0442\u0440\u0435\u0447\u0438 \u0441 \u0440\u0430\u0434\u0438\u043E\u0432\u0435\u0434\u0443\u0449\u0438\u043C.
      \u0413\u043E\u0432\u043E\u0440\u0438\u043B, \u0447\u0442\u043E \u043E\u043D\u0438
      \u0432\u0438\u0434\u0435\u043B\u0438\u0441\u044C \u043F\u0435\u0440\u0435\u0434
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u043C \u044D\u0444\u0438\u0440\u043E\u043C.
      \u0416\u0434\u0430\u043B \u0432 \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0435
      \u043F\u043E\u0441\u043B\u0435 \u0437\u0430\u043A\u0440\u044B\u0442\u0438\u044F
      \u0441\u0442\u043E\u0439\u043A\u0438 \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u0438\xBB.\n\n\u0422\u0435\u043F\u0435\u0440\u044C
      \u0432\u0435\u0434\u0443\u0449\u0438\u0439 \u043F\u0440\u043E\u043F\u0430\u043B.
      \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u044D\u0442\u043E\u0442
      \u0433\u043E\u0441\u0442\u044C \u0432\u0438\u0434\u0435\u043B \u0435\u0433\u043E
      \u043F\u0435\u0440\u0435\u0434 \u0438\u0441\u0447\u0435\u0437\u043D\u043E\u0432\u0435\u043D\u0438\u0435\u043C.
      \u041A\u043D\u0438\u0433\u0430 \u043D\u0435 \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0435\u0442,
      \u0447\u0442\u043E \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C \u0438
      \u043F\u043E\u0447\u0435\u043C\u0443 \u0438\u043C\u044F \u0433\u043E\u0441\u0442\u044F
      \u0441\u0442\u0451\u0440\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 951980033
    m_Localized: "\u041F\u043E\u0434 \u0437\u0430\u043F\u0438\u0441\u044C\u044E:
      \xAB\u041D\u0435 \u043F\u0443\u0442\u0430\u0439\u0442\u0435 \u043E\u0436\u0438\u0434\u0430\u043D\u0438\u0435
      \u0441 \u043F\u0440\u0435\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0435\u043C\xBB.\n\n\u0415\u0441\u043B\u0438
      \u043D\u0430 \u0440\u0438\u0441\u0443\u043D\u043A\u0435 \u0442\u0430 \u0441\u0430\u043C\u0430\u044F
      \u0444\u0438\u0433\u0443\u0440\u0430, \u0432\u043A\u043B\u044E\u0447\u0451\u043D\u043D\u044B\u0439
      \u043F\u0440\u0438\u0451\u043C\u043D\u0438\u043A, \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E,
      \u0437\u0430\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044F
      \u0437\u0430\u043C\u043E\u043B\u0447\u0430\u0442\u044C. \u041C\u043E\u0436\u043D\u043E
      \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u0441 \u0437\u0430\u0440\u044F\u0436\u0435\u043D\u043D\u043E\u0439
      \u0431\u0430\u0442\u0430\u0440\u0435\u0435\u0439, \u0434\u043E\u0431\u0440\u043E\u0432\u043E\u043B\u044C\u043D\u043E
      \u0432\u044B\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u0440\u0430\u0434\u0438\u043E
      \u0438 \u043F\u043E\u0434\u043E\u0439\u0442\u0438. \u0412\u043A\u043B\u044E\u0447\u0438\u0442\u044C
      \u0435\u0433\u043E \u0441\u043D\u043E\u0432\u0430 \u043C\u043E\u0436\u043D\u043E
      \u0432 \u043B\u044E\u0431\u043E\u0439 \u043C\u043E\u043C\u0435\u043D\u0442.\n\n\u041A\u043E\u0433\u0434\u0430
      \u0432\u044B \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u0435 \u0447\u0438\u0442\u0430\u0442\u044C,
      \u0437\u0430\u043F\u0438\u0441\u044C \u043E\u0441\u0442\u0430\u043D\u0435\u0442\u0441\u044F
      \u0437\u0434\u0435\u0441\u044C \u0438 \u0432 \u0432\u0430\u0448\u0435\u043C
      \u0436\u0443\u0440\u043D\u0430\u043B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 951980034
    m_Localized: "\u0412\u044B\u0446\u0432\u0435\u0442\u0448\u0430\u044F \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u044F
      \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0430 \u2014 \u0447\u0435\u0440\u043D\u043E\u0432\u043E\u0439
      \u0442\u0435\u043A\u0441\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 951980035
    m_Localized: "\u041D\u0430 \u0432\u044B\u0446\u0432\u0435\u0442\u0448\u0435\u0439
      \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0438 \u2014 \u0442\u043E\u0442
      \u0436\u0435 \u0440\u044F\u0434 \u0434\u0432\u0435\u0440\u0435\u0439 \u043C\u043E\u0442\u0435\u043B\u044F.
      \u041D\u0430 \u043F\u043E\u043B\u044F\u0445 \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u043E:
      \xAB\u0414\u043E \u0438\u0441\u0447\u0435\u0437\u043D\u043E\u0432\u0435\u043D\u0438\u044F\xBB.
      \u0414\u0430\u0442\u0443 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C
      \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E.\n\n\u0420\u044F\u0434\u043E\u043C
      \u0441 \u043A\u043E\u043C\u043D\u0430\u0442\u043E\u0439 12 \u0441\u0442\u043E\u0438\u0442
      \u0445\u0443\u0434\u043E\u0449\u0430\u0432\u044B\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u0432 \u0442\u0451\u043C\u043D\u043E\u043C \u043F\u0430\u043B\u044C\u0442\u043E.
      \u041B\u0438\u0446\u0430 \u043D\u0435 \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u0442\u044C.
      \u041D\u0430 \u043E\u0431\u043E\u0440\u043E\u0442\u0435 \u0435\u0433\u043E
      \u0441\u0438\u043B\u0443\u044D\u0442 \u043E\u0431\u0432\u0435\u0434\u0451\u043D
      \u043A\u0430\u0440\u0430\u043D\u0434\u0430\u0448\u043E\u043C, \u0441\u043B\u043E\u0432\u043D\u043E
      \u043E\u0447\u0435\u0440\u0442\u0430\u043D\u0438\u044F \u0432\u0430\u0436\u043D\u0435\u0435
      \u043B\u0438\u0446\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 951980036
    m_Localized: "\u0417\u0430 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C
      \u0432\u0438\u0434\u043D\u043E \u043E\u0431\u044A\u044F\u0432\u043B\u0435\u043D\u0438\u0435
      \u0441 \u044D\u043C\u0431\u043B\u0435\u043C\u043E\u0439 \u0440\u0430\u0434\u0438\u043E\u0441\u0442\u0430\u043D\u0446\u0438\u0438.
      \u0417\u0430\u0433\u043D\u0443\u0442\u044B\u0439 \u0443\u0433\u043E\u043B \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u0435\u0449\u0451 \u043E\u0434\u043D\u043E\u0433\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430;
      \u0443\u0437\u043D\u0430\u0442\u044C \u0435\u0433\u043E \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E.\n\n\u042D\u0442\u043E
      \u0437\u0430\u0446\u0435\u043F\u043A\u0430, \u0430 \u043D\u0435 \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E.
      \u0421\u0440\u0430\u0432\u043D\u0438\u0442\u0435 \u043F\u0430\u043B\u044C\u0442\u043E
      \u0438 \u043D\u043E\u043C\u0435\u0440 \u043A\u043E\u043C\u043D\u0430\u0442\u044B
      \u0441 \u0433\u043E\u0441\u0442\u0435\u0432\u043E\u0439 \u043A\u043D\u0438\u0433\u043E\u0439.
      \u0424\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u044F \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442
      \u0443\u0437\u043D\u0430\u0442\u044C \u043E\u0436\u0438\u0434\u0430\u044E\u0449\u0443\u044E
      \u0444\u0438\u0433\u0443\u0440\u0443, \u043D\u043E \u043D\u0435 \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0435\u0442,
      \u043A\u0442\u043E \u044D\u0442\u043E \u0438 \u0447\u0442\u043E \u0441 \u043D\u0435\u0439
      \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 951980037
    m_Localized: "\u041D\u0435\u043F\u0440\u0438\u043D\u044F\u0442\u044B\u0439 \u2014
      \u043E\u0431\u0440\u044B\u0432\u043A\u0438 \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 951980038
    m_Localized: "\xAB\u0412\u044B \u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C\xBB.\n\n\u0424\u0438\u0433\u0443\u0440\u0430
      \u043D\u0435 \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0430\u0435\u0442\u0441\u044F.
      \u0413\u043E\u043B\u043E\u0441 \u0434\u043E\u043D\u043E\u0441\u0438\u0442\u0441\u044F
      \u043E\u0431\u0440\u044B\u0432\u043A\u0430\u043C\u0438, \u043C\u0435\u0436\u0434\u0443
      \u0441\u043B\u043E\u0432\u0430\u043C\u0438 \u2014 \u0442\u0438\u0448\u0438\u043D\u0430.\n\n\xAB\u042F
      \u0434\u0443\u043C\u0430\u043B\u2026 \u0432\u044B \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u0435
      \u0435\u0433\u043E \u0432\u043A\u043B\u044E\u0447\u0451\u043D\u043D\u044B\u043C.
      \u0411\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u043E \u0442\u0430\u043A
      \u0438 \u0434\u0435\u043B\u0430\u0435\u0442\xBB.\n\n\u0424\u0438\u0433\u0443\u0440\u0430
      \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043A \u043F\u0443\u0441\u0442\u044B\u043C \u0434\u0432\u0435\u0440\u044F\u043C.
      \u041D\u0438 \u043E\u0434\u043D\u043E\u0433\u043E \u0443\u0433\u0440\u043E\u0436\u0430\u044E\u0449\u0435\u0433\u043E
      \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F. \u0417\u0430\u0440\u044F\u0436\u0435\u043D\u043D\u044B\u0439
      \u043F\u0440\u0438\u0451\u043C\u043D\u0438\u043A \u043F\u043E-\u043F\u0440\u0435\u0436\u043D\u0435\u043C\u0443
      \u0443 \u0432\u0430\u0441 \u0432 \u0440\u0443\u043A\u0435. \u0415\u0433\u043E
      \u043C\u043E\u0436\u043D\u043E \u0432\u043A\u043B\u044E\u0447\u0438\u0442\u044C
      \u0438 \u0443\u0439\u0442\u0438 \u0432 \u043B\u044E\u0431\u043E\u0439 \u043C\u043E\u043C\u0435\u043D\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 951980039
    m_Localized: "\xAB\u0412\u0435\u0434\u0443\u0449\u0438\u0439 \u0431\u044B\u043B
      \u0437\u0434\u0435\u0441\u044C\u2026 \u0434\u043E \u0442\u043E\u0433\u043E,
      \u043A\u0430\u043A \u0433\u043E\u043B\u043E\u0441 \u0443\u043C\u043E\u043B\u043A.
      \u0421\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u043B \u043E \u043A\u043E\u043C\u043D\u0430\u0442\u0435.
      \u041D\u0435 \u043E \u043C\u043E\u0435\u0439. \u042F \u0436\u0434\u0430\u043B\u2026
      \u0442\u0430\u043C, \u0433\u0434\u0435 \u043A\u043E\u043D\u0447\u0430\u0435\u0442\u0441\u044F
      \u0441\u0432\u0435\u0442\xBB.\n\n\u0412\u044B \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442\u0435,
      \u0432\u0438\u0434\u0435\u043B \u043B\u0438 \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044C,
      \u043A\u0430\u043A \u0432\u0435\u0434\u0443\u0449\u0438\u0439 \u0443\u0448\u0451\u043B.\n\n\xAB\u042F
      \u0441\u043B\u044B\u0448\u0430\u043B \u043C\u0430\u0448\u0438\u043D\u0443.
      \u0412\u0438\u0434\u0435\u043B \u043F\u0430\u043B\u044C\u0442\u043E. \u042D\u0442\u043E
      \u043D\u0435\u2026 \u0442\u043E \u0436\u0435 \u0441\u0430\u043C\u043E\u0435,
      \u0447\u0442\u043E \u0432\u0438\u0434\u0435\u0442\u044C, \u043A\u0430\u043A
      \u0443\u0445\u043E\u0434\u0438\u0442 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\xBB.\n\n\u0420\u0430\u0441\u0441\u043A\u0430\u0437
      \u043D\u0435\u043F\u043E\u043B\u043E\u043D. \u041E\u043D \u043D\u0435 \u0434\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u043D\u0438 \u0441\u043C\u0435\u0440\u0442\u044C, \u043D\u0438 \u0447\u044C\u044E-\u043B\u0438\u0431\u043E
      \u0432\u0438\u043D\u0443, \u043D\u0438 \u0442\u043E\u0447\u043D\u044B\u0439
      \u043F\u043E\u0440\u044F\u0434\u043E\u043A \u0441\u043E\u0431\u044B\u0442\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 951980040
    m_Localized: "\xAB\u0421\u0442\u0430\u043D\u0446\u0438\u044F. \u041D\u0430\u0447\u043D\u0438\u0442\u0435
      \u0442\u0430\u043C. \u041E\u043D\u0438 \u0445\u0440\u0430\u043D\u0438\u043B\u0438\u2026
      \u0431\u0443\u043C\u0430\u0436\u043D\u0443\u044E \u043A\u043E\u043F\u0438\u044E.
      \u041D\u0430 \u0441\u043B\u0443\u0447\u0430\u0439, \u0435\u0441\u043B\u0438
      \u043F\u043B\u0451\u043D\u043A\u0430\u2026\xBB\n\n\u041E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0435
      \u0442\u043E\u043D\u0435\u0442 \u0432 \u0433\u0443\u043B\u0435 \u043B\u0430\u043C\u043F.\n\n\u0412\u044B
      \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442\u0435, \u043E
      \u043A\u0430\u043A\u043E\u0439 \u0431\u0443\u043C\u0430\u0433\u0435 \u0440\u0435\u0447\u044C.
      \u0424\u0438\u0433\u0443\u0440\u0430 \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u0435\u0442:
      \xAB\u041F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0430 \u044D\u0444\u0438\u0440\u0430.
      \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F \u043F\u0435\u0440\u0435\u0434\u0430\u0447\u0430.
      \u0418\u0449\u0438\u0442\u0435\u2026 \u0442\u043E \u043C\u0435\u0441\u0442\u043E,
      \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u0438\u0437\u043C\u0435\u043D\u0438\u043B\u0438\xBB.\n\n\u042D\u0442\u043E
      \u043C\u043E\u0436\u043D\u043E \u043D\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E
      \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u043D\u0430 \u0440\u0430\u0434\u0438\u043E\u0441\u0442\u0430\u043D\u0446\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 951980041
    m_Localized: "\u041D\u0430 \u043C\u0438\u0433 \u043E\u0447\u0435\u0440\u0442\u0430\u043D\u0438\u044F
      \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u044E\u0442 \u043F\u0430\u043B\u044C\u0442\u043E
      \u0441 \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0438 \u043C\u043E\u0442\u0435\u043B\u044F.
      \u0417\u0430\u0442\u0435\u043C \u043A\u0440\u0430\u044F \u0444\u0438\u0433\u0443\u0440\u044B
      \u0441\u043D\u043E\u0432\u0430 \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u044F\u044E\u0442\u0441\u044F
      \u0432 \u0442\u0435\u043D\u0438.\n\n\xAB\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430.
      \u041D\u0435 \u043F\u0438\u0448\u0438\u0442\u0435\u2026 \u0447\u0442\u043E
      \u0437\u043D\u0430\u0435\u0442\u0435, \u0447\u0442\u043E \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C.
      \u0412\u044B \u043C\u0435\u043D\u044F \u0443\u0441\u043B\u044B\u0448\u0430\u043B\u0438.
      \u0412\u043E\u0442 \u0438 \u0432\u0441\u0451\xBB.\n\n\u0423 \u0432\u0430\u0441
      \u0435\u0441\u0442\u044C \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u0438\u044F
      \u0438 \u043D\u043E\u0432\u0430\u044F \u0437\u0430\u0446\u0435\u043F\u043A\u0430,
      \u043D\u043E \u0434\u0435\u043B\u043E \u043D\u0435 \u0440\u0430\u0441\u043A\u0440\u044B\u0442\u043E.
      \u041A \u043A\u043D\u0438\u0433\u0435 \u0438 \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0438
      \u043C\u043E\u0436\u043D\u043E \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F.
      \u041D\u0438\u043A\u0442\u043E \u043D\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442
      \u043E\u0442\u0434\u0430\u0442\u044C \u043F\u0440\u0438\u0451\u043C\u043D\u0438\u043A
      \u0438\u043B\u0438 \u043E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F
      \u043E\u0442 \u0437\u0430\u043F\u0438\u0441\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 951980042
    m_Localized: "\u041D\u041E\u0412\u0410\u042F \u0417\u0410\u0426\u0415\u041F\u041A\u0410:
      \u043F\u043E\u0441\u0435\u0442\u0438\u0442\u044C \u0440\u0430\u0434\u0438\u043E\u0441\u0442\u0430\u043D\u0446\u0438\u044E
      \u0438 \u043D\u0430\u0439\u0442\u0438 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0443
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0433\u043E \u044D\u0444\u0438\u0440\u0430
      \u043F\u0440\u043E\u043F\u0430\u0432\u0448\u0435\u0433\u043E \u0432\u0435\u0434\u0443\u0449\u0435\u0433\u043E.
      \u041F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C \u0434\u0435\u043B\u0430\u0442\u044C
      \u0432\u044B\u0432\u043E\u0434\u044B, \u0441\u0440\u0430\u0432\u043D\u0438\u0442\u0435
      \u0435\u0451 \u0441 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u043E\u043C
      \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044F.\n\n\u0417\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u0435
      \u044D\u0442\u0443 \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0443, \u0447\u0442\u043E\u0431\u044B
      \u0434\u043E\u0431\u0430\u0432\u0438\u0442\u044C \u043E\u0431\u0440\u044B\u0432\u043A\u0438
      \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u0438\u0439 \u0432 \u0436\u0443\u0440\u043D\u0430\u043B.
      \u0421\u0430\u043C\u043E\u0439 \u0440\u0430\u0434\u0438\u043E\u0441\u0442\u0430\u043D\u0446\u0438\u0438
      \u0432 \u044D\u0442\u043E\u043C \u043F\u0440\u043E\u0442\u043E\u0442\u0438\u043F\u0435
      \u0435\u0449\u0451 \u043D\u0435\u0442.\n\n\u042D\u043F\u0438\u0437\u043E\u0434
      \xAB\u041F\u0435\u0440\u0432\u044B\u0439 \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044C\xBB
      \u0437\u0430\u0432\u0435\u0440\u0448\u0451\u043D. \u041C\u043E\u0436\u043D\u043E
      \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0435
      \u0438 \u043F\u0435\u0440\u0435\u0447\u0438\u0442\u0430\u0442\u044C \u0432\u0441\u0435
      \u0441\u043E\u0431\u0440\u0430\u043D\u043D\u044B\u0435 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B,
      \u043D\u0430\u0436\u0430\u0432 Tab."
    m_Metadata:
      m_Items: []
  - m_Id: 951980043
    m_Localized: "\u041F\u0415\u0420\u0412\u042B\u0419 \u0421\u0412\u0418\u0414\u0415\u0422\u0415\u041B\u042C"
    m_Metadata:
      m_Items: []
  - m_Id: 951980044
    m_Localized: "\u041F\u043E\u043A\u0430 \u043D\u0435\u0442 \u0441\u043E\u0431\u0440\u0430\u043D\u043D\u044B\u0445
      \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u043E\u0432. \u041E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435
      \u0433\u043E\u0441\u0442\u0435\u0432\u0443\u044E \u043A\u043D\u0438\u0433\u0443
      \u0438 \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u044E, \u043D\u0430\u0436\u0430\u0432
      E. \u0417\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u0435 \u0447\u0442\u0435\u043D\u0438\u0435,
      \u0447\u0442\u043E\u0431\u044B \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C
      \u0437\u0430\u043F\u0438\u0441\u044C \u0432 \u0436\u0443\u0440\u043D\u0430\u043B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 951980045
    m_Localized: "\u0418\u0441\u0441\u043B\u0435\u0434\u0443\u0439\u0442\u0435 \u043A\u043E\u0440\u0438\u0434\u043E\u0440.
      \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u0432\u044B\u043A\u043B\u044E\u0447\u0438\u0442\u044C
      \u043F\u0440\u0438\u0451\u043C\u043D\u0438\u043A \u0443 \u0434\u0430\u043B\u044C\u043D\u0438\u0445
      \u0434\u0432\u0435\u0440\u0435\u0439: Left Shift \u2014 \u0440\u0430\u0434\u0438\u043E,
      E \u2014 \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u043F\u0440\u0435\u0434\u043C\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 951980046
    m_Localized: "\u0412 \u0442\u0438\u0448\u0438\u043D\u0435 \u0436\u0434\u0451\u0442
      \u0444\u0438\u0433\u0443\u0440\u0430. \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435
      \u0432\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u0440\u0430\u0434\u0438\u043E.
      \u0413\u043E\u0441\u0442\u0435\u0432\u0430\u044F \u043A\u043D\u0438\u0433\u0430
      \u043C\u043E\u0442\u0435\u043B\u044F \u043C\u043E\u0436\u0435\u0442 \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u0442\u044C,
      \u043A\u0442\u043E \u0437\u0434\u0435\u0441\u044C \u0436\u0434\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 951980047
    m_Localized: "\u0421\u0438\u0433\u043D\u0430\u043B \u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u0444\u0438\u0433\u0443\u0440\u0443. \u041E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435
      \u0441\u0432\u0435\u0442\u043B\u0443\u044E \u0433\u043E\u0441\u0442\u0435\u0432\u0443\u044E
      \u043A\u043D\u0438\u0433\u0443 \u0443 \u0441\u0442\u043E\u0439\u043A\u0438
      \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u0438, \u0441\u043B\u0435\u0432\u0430
      \u043E\u0442 \u0442\u0435\u0441\u0442\u043E\u0432\u043E\u0433\u043E \u0443\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 951980048
    m_Localized: "\u0413\u043E\u0441\u0442\u044C \u043C\u043E\u0436\u0435\u0442 \u043E\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F
      \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u0435\u043C. \u0421\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u0435
      \u0437\u0430\u0440\u044F\u0434, \u0432\u043A\u043B\u044E\u0447\u0438\u0442\u0435
      \u0440\u0430\u0434\u0438\u043E, \u0437\u0430\u0442\u0435\u043C \u0434\u043E\u0431\u0440\u043E\u0432\u043E\u043B\u044C\u043D\u043E
      \u0432\u044B\u043A\u043B\u044E\u0447\u0438\u0442\u0435 \u0435\u0433\u043E \u0438
      \u0432\u0435\u0440\u043D\u0438\u0442\u0435\u0441\u044C \u0432 \u0434\u0430\u043B\u044C\u043D\u0438\u0439
      \u043A\u043E\u043D\u0435\u0446 \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 951980049
    m_Localized: "\u0412\u044B \u0432\u044B\u0431\u0440\u0430\u043B\u0438 \u0442\u0438\u0448\u0438\u043D\u0443.
      \u041F\u043E\u0434\u043E\u0439\u0434\u0438\u0442\u0435 \u043A \u0444\u0438\u0433\u0443\u0440\u0435
