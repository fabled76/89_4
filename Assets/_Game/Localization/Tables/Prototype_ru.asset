  - m_Id: 264371628281872
    m_Localized: "\u0417\u0430\u0434\u0430\u043D\u0438\u0435: [TOWN_NAME]"
    m_Metadata:
      m_Items: []
  - m_Id: 264371628281873
    m_Localized: "\u0412\u0435\u0434\u0443\u0449\u0438\u0439 [STATION_NAME] \u043E\u0431\u044A\u044F\u0432\u043B\u0435\u043D
      \u043F\u0440\u043E\u043F\u0430\u0432\u0448\u0438\u043C.\n\n\u0427\u0438\u0442\u0430\u0442\u0435\u043B\u044C
      \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442, \u043F\u043E\u0447\u0435\u043C\u0443
      \u0440\u0430\u0434\u0438\u043E\u0441\u0442\u0430\u043D\u0446\u0438\u044F \u043D\u0435
      \u043E\u0431\u044A\u044F\u0432\u0438\u043B\u0430 \u043E \u0437\u0430\u043C\u0435\u043D\u0435.
      \u041D\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0433\u043E \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u044F
      \u044D\u0442\u043E\u043C\u0443 \u043F\u043E\u043A\u0430 \u043D\u0435\u0442.\n\n\u0423\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0451\u043D\u043D\u044B\u0435
      \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F \u0432\u0435\u0434\u0443\u0449\u0435\u0433\u043E.
      \u041F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0435 \u0441 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u0430\u043C\u0438
      \u0441\u0442\u0430\u043D\u0446\u0438\u0438 \u0438 \u043D\u0430\u0439\u0434\u0438\u0442\u0435
      \u043D\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043C\u044B\u0435 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u044F
      \u0437\u0430 \u0435\u0451 \u043F\u0440\u0435\u0434\u0435\u043B\u0430\u043C\u0438.\n\n\u0420\u0430\u0437\u0440\u0435\u0448\u0451\u043D\u043D\u044B\u0435
      \u0440\u0430\u0441\u0445\u043E\u0434\u044B: \u043F\u0440\u043E\u0435\u0437\u0434
      \u0442\u0443\u0434\u0430 \u0438 \u043E\u0431\u0440\u0430\u0442\u043D\u043E
      \u0438 \u043E\u0434\u043D\u0430 \u043D\u043E\u0447\u044C \u0432 [MOTEL_NAME].
      \u0411\u0440\u043E\u043D\u044C \u043F\u0440\u0438\u043B\u0430\u0433\u0430\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 264371628281874
    m_Localized: "\u0416\u0423\u0420\u041D\u0410\u041B\u0418\u0421\u0422: \xAB\u041E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435
